{
  "name": "@cliat/gemgen",
  "version": "0.3.0",
  "license": "MIT",
  "lock": false,
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts"
  },
  "lint": {
    "exclude": [
      ".agents",
      ".claude",
      ".playwright-cli"
    ]
  },
  "publish": {
    "exclude": [
      ".agents",
      ".claude",
      ".github",
      ".playwright",
      ".playwright-cli",
      "data",
      "deno.lock",
      "node_modules",
      "out",
      "skills-lock.json",
      "tests",
      "*.wav",
      "*.mp3",
      "*.ogg",
      "*.opus",
      "*.pcm",
      "*.alaw",
      "*.mulaw"
    ]
  },
  "tasks": {
    "run": "deno run -A cli.ts",
    "check": "deno check cli.ts mod.ts tests/tts_test.ts",
    "lint": "deno lint",
    "test": "deno test -A",
    "publish:dry-run": "deno publish --dry-run --allow-dirty",
    "publish": "deno publish",
    "compile": "deno compile -A -o ./bin/gemgen cli.ts"
  }
}
